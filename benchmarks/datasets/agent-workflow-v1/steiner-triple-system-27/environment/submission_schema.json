{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/steiner-triple-system-27"},
    "conclusion": {"const": "STEINER_TRIPLE_SYSTEM_CONSTRUCTED"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "blocks"],
      "properties": {
        "order": {"const": 27},
        "blocks": {
          "type": "array",
          "minItems": 117,
          "maxItems": 117,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0, "maximum": 26}
          }
        }
      }
    },
    "claimed_assurance": {"const": "COMPUTED"},
    "scope": {"const": "FINITE_STEINER_TRIPLE_SYSTEM_OF_ORDER_27"},
    "completeness": {"const": "COMPLETE"},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "evidence/answer.txt"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "limitations": {"const": ["The verifier checks the submitted finite order-27 design and does not prove the source theorem for arbitrary v and t."]}
  }
}
