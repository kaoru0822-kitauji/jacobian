{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/complete-runtime-startup"},
    "conclusion": {"const": "MEASURED"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "benchmark_count", "raw_format"],
      "properties": {
        "suite": {"const": "jacobian-runtime-startup"},
        "benchmark_count": {"type": "integer", "minimum": 1},
        "raw_format": {"const": "pyperf"}
      }
    },
    "claimed_assurance": {"enum": ["UNVERIFIED", "COMPUTED"]},
    "scope": {"type": "string", "minLength": 1},
    "completeness": {"const": "COMPLETE"},
    "evidence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"enum": ["evidence/pyperf.json", "evidence/environment.json"]},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
