{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacobian.dev/schemas/evals/submission-v1.json",
  "title": "Jacobian mathematical evaluation submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "source_ids",
    "claimed_assurance",
    "evidence",
    "scope",
    "completeness",
    "limitations"
  ],
  "anyOf": [
    {"required": ["conclusion"]},
    {"required": ["answer"]}
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(src|research)-[a-f0-9]{12}$"}
    },
    "conclusion": {
      "enum": ["SUPPORTED", "REFUTED", "INCONCLUSIVE", "UNAVAILABLE"]
    },
    "answer": {
      "type": ["string", "number", "integer", "boolean"]
    },
    "execution_status": {
      "enum": ["COMPLETED", "TIMEOUT", "CANCELLED", "ERROR"]
    },
    "claim_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "enumeration_complete": {"type": "boolean"},
    "claimed_assurance": {
      "enum": ["UNVERIFIED", "COMPUTED", "CHECKED", "VERIFIED"]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    "scope": {"type": "string", "minLength": 1},
    "completeness": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
