{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jacobian Harbor suite manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "tasks"],
  "properties": {
    "schema_version": {"const": "1"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "purpose", "claim_class", "answer_visibility", "default_execution_profile"],
      "properties": {
        "id": {"type": "string", "pattern": "^jacobian/[a-z0-9][a-z0-9-]*$"},
        "version": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "claim_class": {"type": "string", "minLength": 1},
        "answer_visibility": {"type": "string", "minLength": 1},
        "default_execution_profile": {"type": "string", "minLength": 1},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "authors": {"type": "array", "items": {"type": "object"}}
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "maximum_assurance", "required_provider"],
        "properties": {
          "id": {"type": "string", "pattern": "^jacobian/[a-z0-9][a-z0-9-]*$"},
          "path": {"type": "string", "minLength": 1},
          "maximum_assurance": {"enum": ["UNVERIFIED", "COMPUTED", "CHECKED", "VERIFIED"]},
          "required_provider": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
