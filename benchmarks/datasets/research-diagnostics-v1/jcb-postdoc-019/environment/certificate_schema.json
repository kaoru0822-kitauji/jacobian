{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": {"type": "string", "pattern": "^(?:0|-?[1-9][0-9]*)$", "maxLength": 257},
        "den": {"type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 256}
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coefficient", "exponents"],
      "properties": {
        "coefficient": {"$ref": "#/$defs/rational"},
        "exponents": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {"type": "integer", "minimum": 0, "maximum": 32}
        }
      }
    },
    "polynomial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms"],
      "properties": {
        "terms": {
          "type": "array",
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/term"},
          "description": "Terms may be supplied in any order; the verifier canonicalizes them by exponent tuple before replay."
        }
      }
    },
    "named_polynomial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["polynomial_id", "polynomial"],
      "properties": {
        "polynomial_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*$", "maxLength": 64},
        "polynomial": {"$ref": "#/$defs/polynomial"}
      }
    },
    "multiplier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator_id", "multiplier"],
      "properties": {
        "generator_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*$", "maxLength": 64},
        "multiplier": {"$ref": "#/$defs/polynomial"}
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chart_id", "variable_order", "generators", "multipliers", "identity_rhs"],
      "properties": {
        "chart_id": {"type": "string", "pattern": "^a(?:20|11|02)-b(?:30|21|12|03)$"},
        "variable_order": {
          "const": ["a20", "a11", "a02", "b20", "b11", "b02", "b30", "b21", "b12", "b03", "t"]
        },
        "generators": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/named_polynomial"}},
        "multipliers": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/multiplier"}},
        "identity_rhs": {"const": {"num": "1", "den": "1"}}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "statement_id", "coefficient_domain", "variable_order", "chart_encoding", "identity", "charts"],
  "properties": {
    "schema_version": {"const": "1"},
    "statement_id": {"const": "normalized-bivariate-jacobian-degree-2-3"},
    "coefficient_domain": {"const": "QQ"},
    "variable_order": {"const": ["a20", "a11", "a02", "b20", "b11", "b02", "b30", "b21", "b12", "b03", "t"]},
    "chart_encoding": {"const": "rabinowitsch-product-cover"},
    "identity": {"const": "sum(h_i*f_i)=1"},
    "charts": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/chart"}}
  }
}
