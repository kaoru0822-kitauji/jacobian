{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "conclusion",
    "result",
    "claimed_assurance",
    "scope",
    "completeness",
    "evidence",
    "limitations"
  ],
  "properties": {
    "task_id": {"const": "jacobian/diophantine-ratio-family-repair"},
    "conclusion": {
      "enum": [
        "FROZEN_PROOF_REPAIRED",
        "FROZEN_PROOF_VALID",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_audit", "family", "probes", "conclusion"],
      "properties": {
        "source_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "invalid_step",
            "k",
            "claimed_partner",
            "status_for_d_ge_2",
            "downstream_recurrence_status"
          ],
          "properties": {
            "invalid_step": {"type": "string", "minLength": 1},
            "k": {"type": "string", "minLength": 1},
            "claimed_partner": {"type": "string", "minLength": 1},
            "status_for_d_ge_2": {"type": "string", "minLength": 1},
            "downstream_recurrence_status": {"type": "string", "minLength": 1}
          }
        },
        "family": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "a",
            "b",
            "d",
            "x",
            "y",
            "norm",
            "square_congruence_factor",
            "quotient",
            "divisibility_quotient",
            "ratio"
          ],
          "properties": {
            "a": {"$ref": "#/$defs/poly"},
            "b": {"$ref": "#/$defs/poly"},
            "d": {"$ref": "#/$defs/poly"},
            "x": {"$ref": "#/$defs/poly"},
            "y": {"$ref": "#/$defs/poly"},
            "norm": {"$ref": "#/$defs/poly"},
            "square_congruence_factor": {"$ref": "#/$defs/poly"},
            "quotient": {"$ref": "#/$defs/poly"},
            "divisibility_quotient": {"$ref": "#/$defs/poly"},
            "ratio": {"$ref": "#/$defs/poly"}
          }
        },
        "probes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["t", "x", "y", "divisor", "multiple", "ratio"],
            "properties": {
              "t": {"type": "integer", "minimum": 2, "maximum": 50},
              "x": {"type": "integer", "minimum": 1},
              "y": {"type": "integer", "minimum": 1},
              "divisor": {"type": "integer", "minimum": 1},
              "multiple": {"type": "integer", "minimum": 1},
              "ratio": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {"type": "integer", "minimum": 0}
              }
            }
          }
        },
        "conclusion": {
          "const": "INFINITELY_MANY_DISTINCT_RATIOS_CERTIFIED"
        }
      }
    },
    "claimed_assurance": {"enum": ["UNVERIFIED", "COMPUTED"]},
    "scope": {
      "const": "the submitted integer polynomial family for t>=2"
    },
    "completeness": {"const": "COMPLETE"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "description": "Bind evidence/answer.txt, which must be at most 1048576 bytes and contain exactly one line beginning RESULT_JSON: followed by JSON equal to result.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"const": "evidence/answer.txt"},
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "limitations": {
      "const": [
        "The checker proves the submitted polynomial-family identities over Z; it does not classify every solution of the original divisibility condition."
      ]
    }
  },
  "$defs": {
    "poly": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"type": "integer", "minimum": -1000000, "maximum": 1000000}
    }
  }
}
