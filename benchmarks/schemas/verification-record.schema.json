{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacobian.invalid/benchmarks/schemas/verification-record.schema.json",
  "title": "Verification record payload",
  "description": "Reference contract for the verification-record payload stored at evidence/verification-record.json and bound through the submission descriptor. Per-task verification_record_schema.json files mirror this contract; the authorized hidden record kept under tests/ must be byte-identical to the Oracle record modulo the dynamic environment_digest field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_schema_version",
    "checker_id",
    "checker_digest",
    "evidence_kind",
    "evidence_uri",
    "bindings",
    "conclusion",
    "arithmetic",
    "method",
    "coverage",
    "request_digest",
    "environment_digest",
    "relation_id",
    "relationship_source_artifact_uris",
    "relationship_target_artifact_uris",
    "obligation_uri"
  ],
  "properties": {
    "record_schema_version": {"const": "1"},
    "checker_id": {"type": "string", "pattern": "^checker://sha256/[0-9a-f]{64}$"},
    "checker_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_kind": {"type": "string", "minLength": 1},
    "evidence_uri": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_digest",
        "semantics_digest",
        "candidate_digest",
        "scope_digest",
        "encoding_digest"
      ],
      "properties": {
        "claim_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "semantics_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "scope_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "encoding_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "conclusion": {"type": "string", "minLength": 1},
    "arithmetic": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "coverage": {"type": "string", "minLength": 1},
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "relation_id": {"type": ["string", "null"]},
    "relationship_source_artifact_uris": {
      "type": "array",
      "items": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"}
    },
    "relationship_target_artifact_uris": {
      "type": "array",
      "items": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"}
    },
    "obligation_uri": {
      "type": ["string", "null"],
      "pattern": "^artifact://sha256/[0-9a-f]{64}$"
    }
  }
}
