[Unit]
Description=Restore the public Jacobian MCP Tailscale Funnel
After=network-online.target tailscaled.service jacobian-mcp.service jacobian-caddy.service
Requires=tailscaled.service jacobian-mcp.service jacobian-caddy.service
PartOf=tailscaled.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/tailscale status
ExecStart=/usr/bin/tailscale funnel --bg --yes http://127.0.0.1:8766
ExecStop=/usr/bin/tailscale funnel --https=443 off
RemainAfterExit=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
