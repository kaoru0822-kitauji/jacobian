{
  "jobs_dir": "benchmarks/results/agent-workflow-v1",
  "n_attempts": 1,
  "timeout_multiplier": 1,
  "orchestrator": {
    "type": "local",
    "n_concurrent_trials": 1,
    "quiet": false
  },
  "environment": {
    "type": "docker",
    "force_build": true,
    "delete": true,
    "extra_docker_compose": [
      "benchmarks/datasets/agent-workflow-v1/jacobian-observation.compose.yaml"
    ]
  },
  "agents": [
    {
      "name": "codex",
      "mcp_servers": [
        {
          "name": "jacobian",
          "transport": "streamable-http",
          "url": "http://jacobian:8000/mcp"
        }
      ]
    }
  ],
  "datasets": [
    {
      "path": "benchmarks/datasets/agent-workflow-v1",
      "task_names": [
        "graph-counterexample"
      ]
    }
  ]
}
