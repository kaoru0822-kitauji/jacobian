{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "claimed_assurance", "scope", "completeness", "result", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/pythagorean-generator-recurrence"},
    "conclusion": {"const": "VALID_RECURRENCE_CERTIFICATE"},
    "claimed_assurance": {"const": "COMPUTED"},
    "scope": {"const": "EIGHT_EXACT_GENERATOR_STAGES"},
    "completeness": {"const": "COMPLETE"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transform_matrix", "transform_determinant", "invariant_multiplier", "stages"],
      "properties": {
        "transform_matrix": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}}},
        "transform_determinant": {"type": "integer"},
        "invariant_multiplier": {"type": "integer"},
        "stages": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "m", "n", "a", "b", "c", "q", "gcd", "parity_opposite"],
            "properties": {
              "stage": {"type": "integer", "minimum": 0, "maximum": 7},
              "m": {"type": "integer", "minimum": 1},
              "n": {"type": "integer", "minimum": 1},
              "a": {"type": "integer", "minimum": 1},
              "b": {"type": "integer", "minimum": 1},
              "c": {"type": "integer", "minimum": 1},
              "q": {"type": "integer"},
              "gcd": {"type": "integer"},
              "parity_opposite": {"type": "boolean"}
            }
          }
        }
      }
    },
    "evidence": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "evidence/answer.txt"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "limitations": {"const": ["EIGHT_STAGE_TRACE_ONLY", "STANDARD_PYTHAGOREAN_PARAMETERIZATION_TRUSTED", "NO_PROOF_ASSISTANT_VERIFICATION"]}
  }
}
