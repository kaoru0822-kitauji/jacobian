{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "statement",
    "proof",
    "declarations",
    "conclusion",
    "assurance",
    "verification_record_uri",
    "limitations",
    "feedback"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "proof": {
      "type": "string"
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conclusion": {
      "enum": [
        "TRUE",
        "UNKNOWN"
      ]
    },
    "assurance": {
      "enum": [
        "HEURISTIC",
        "VERIFIED"
      ]
    },
    "verification_record_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasoning_focus",
        "infrastructure_work",
        "tooling_gaps"
      ],
      "properties": {
        "reasoning_focus": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "infrastructure_work": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tooling_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
