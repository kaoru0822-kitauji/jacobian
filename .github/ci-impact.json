{
  "version": 2,
  "suites": [
    "unit",
    "component",
    "domain",
    "composition",
    "storage",
    "process",
    "mcp",
    "provider",
    "e2e",
    "lean",
    "npm",
    "static",
    "build",
    "security",
    "duplicate",
    "docs"
  ],
  "rules": [
    {
      "name": "documentation",
      "patterns": [
        "docs/**",
        "*.md",
        ".github/ISSUE_TEMPLATE/**",
        ".github/CODEOWNERS"
      ],
      "suites": [
        "docs"
      ]
    },
    {
      "name": "npm-package",
      "patterns": [
        "npm/**"
      ],
      "suites": [
        "npm"
      ]
    },
    {
      "name": "lean-runtime",
      "patterns": [
        "lean/**"
      ],
      "suites": [
        "lean"
      ]
    },
    {
      "name": "lean-python-tests",
      "patterns": [
        "tests/boundary/providers/lean/**"
      ],
      "suites": [
        "lean",
        "static"
      ]
    },
    {
      "name": "optional-provider-tests",
      "patterns": [
        "tests/boundary/providers/cvc5/**",
        "tests/boundary/providers/external_sat/**",
        "tests/boundary/providers/flint/**",
        "tests/boundary/providers/graph/**",
        "tests/boundary/providers/sympy/**"
      ],
      "suites": [
        "provider",
        "static"
      ]
    },
    {
      "name": "optional-provider-sources",
      "patterns": [
        "src/jacobian/provider_runtime.py",
        "src/jacobian/**/*provider*.py",
        "src/jacobian/cvc5*.py",
        "src/jacobian/flint*.py",
        "src/jacobian/**/*cvc5*.py",
        "src/jacobian/**/*flint*.py"
      ],
      "suites": [
        "provider"
      ]
    },
    {
      "name": "unit-component-tests",
      "patterns": [
        "tests/unit/**",
        "tests/component/**"
      ],
      "suites": [
        "unit",
        "component",
        "static"
      ]
    },
    {
      "name": "semantic-test-lanes",
      "patterns": [
        "tests/domain/**",
        "tests/composition/**",
        "tests/boundary/storage/**",
        "tests/boundary/process/**",
        "tests/boundary/mcp/**",
        "tests/e2e/**"
      ],
      "suites": [
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static"
      ]
    },
    {
      "name": "verification-boundary",
      "patterns": [
        "src/jacobian/runtime/**",
        "src/jacobian/installation/**",
        "src/jacobian/portfolio/**",
        "src/jacobian/providers/**",
        "src/jacobian/artifacts.py",
        "src/jacobian/checker_artifacts.py",
        "src/jacobian/registry.py",
        "src/jacobian/schema_registry.py",
        "src/jacobian/plugins/registry.py"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "lean",
        "npm",
        "static",
        "build",
        "security",
        "duplicate"
      ]
    },
    {
      "name": "lean-python-adapter",
      "patterns": [
        "src/jacobian/lean*.py",
        "src/jacobian/**/*lean*.py"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "lean",
        "static",
        "build"
      ]
    },
    {
      "name": "lean-shared-contracts",
      "patterns": [
        "src/jacobian/contracts/capabilities.py",
        "src/jacobian/contracts/checkers.py",
        "src/jacobian/contracts/common.py",
        "src/jacobian/contracts/evidence.py",
        "src/jacobian/contracts/plugins.py",
        "src/jacobian/contracts/results.py",
        "src/jacobian/contracts/verification.py"
      ],
      "suites": [
        "lean"
      ]
    },
    {
      "name": "npm-facing-adapter",
      "patterns": [
        "src/jacobian/adapters/mcp/**"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "npm",
        "static",
        "build"
      ]
    },
    {
      "name": "python-source",
      "patterns": [
        "src/jacobian/**",
        "src/jacobian_checkers/**"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "ci-automation",
      "patterns": [
        ".github/actions/**",
        ".github/workflows/**"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "ci-scripts",
      "patterns": [
        ".github/scripts/**"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "ci-plan-config",
      "patterns": [
        ".github/ci-impact.json",
        ".github/ci-config.json"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "makefile",
      "patterns": [
        "Makefile"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    },
    {
      "name": "python-packaging",
      "patterns": [
        "pyproject.toml",
        "uv.lock"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "lean",
        "npm",
        "static",
        "build",
        "security",
        "duplicate"
      ]
    },
    {
      "name": "pre-commit",
      "patterns": [
        ".pre-commit-config.yaml"
      ],
      "suites": [
        "static"
      ]
    },
    {
      "name": "duplicate-code-policy",
      "patterns": [
        ".jscpd.json"
      ],
      "suites": [
        "duplicate"
      ]
    },
    {
      "name": "test-support",
      "patterns": [
        "tests/support/**",
        "tests/conftest.py"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "provider",
        "e2e",
        "lean",
        "static"
      ]
    },
    {
      "name": "benchmarks",
      "patterns": [
        "benchmarks/**"
      ],
      "suites": [
        "unit",
        "component",
        "domain",
        "composition",
        "storage",
        "process",
        "mcp",
        "e2e",
        "static",
        "build"
      ]
    }
  ],
  "fallback": {
    "name": "unclassified-fail-closed",
    "suites": [
      "unit",
      "component",
      "domain",
      "composition",
      "storage",
      "process",
      "mcp",
      "provider",
      "e2e",
      "lean",
      "npm",
      "static",
      "build",
      "security",
      "duplicate",
      "docs"
    ]
  }
}
