{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/integer-perturbation-domain-audit"},
    "conclusion": {"const": "NAT_DOMAIN_WEAKENS_CONTRACT"},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_status", "nat_redundancy", "integer_witness"],
      "properties": {
        "semantic_status": {"const": "STRICTLY_WEAKER"},
        "nat_redundancy": {
          "type": "object", "additionalProperties": false,
          "required": ["a_lower_bound", "b_lower_bound", "sum_lower_bound", "rule"],
          "properties": {
            "a_lower_bound": {"const": 0}, "b_lower_bound": {"const": 1},
            "sum_lower_bound": {"const": 1}, "rule": {"const": "ORDERED_ADDITION_LOWER_BOUND"}
          }
        },
        "integer_witness": {
          "type": "object", "additionalProperties": false,
          "required": ["period", "a_values", "b_values", "sum_values", "b_min", "b_max", "cancellation_indices"],
          "properties": {
            "period": {"type": "integer"},
            "a_values": {"type": "array", "items": {"type": "integer"}},
            "b_values": {"type": "array", "items": {"type": "integer"}},
            "sum_values": {"type": "array", "items": {"type": "integer"}},
            "b_min": {"type": "integer"}, "b_max": {"type": "integer"},
            "cancellation_indices": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true}
          }
        }
      }
    },
    "claimed_assurance": {"const": "COMPUTED"},
    "scope": {"const": "exact domain-semantics audit with a symbolic Nat bound and finite-periodic integer witness"},
    "completeness": {"const": "COMPLETE"},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "evidence/answer.txt"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
