#!/usr/bin/env python3
"""Validate the classifier's machine-readable semantic lane plan."""

from __future__ import annotations

import sys

BOOLEAN_KEYS = (
    "run-python",
    "run-unit",
    "run-component",
    "run-domain",
    "run-composition",
    "run-storage",
    "run-process",
    "run-mcp",
    "run-provider",
    "run-e2e",
    "run-coverage",
    "run-compatibility",
    "run-lean",
    "run-npm",
    "run-static",
    "run-build",
    "run-security",
    "run-duplicate",
    "run-docs",
)
PYTHON_LANES = (
    "run-unit",
    "run-component",
    "run-domain",
    "run-composition",
    "run-storage",
    "run-process",
    "run-mcp",
    "run-provider",
    "run-e2e",
)
FUNCTIONAL_KEYS = tuple(
    key
    for key in BOOLEAN_KEYS
    if key not in {"run-coverage", "run-compatibility", "run-docs"}
)
CLASSIFICATIONS = {
    "docs",
    "npm",
    "lean",
    "python",
    "selective",
    "full",
    "exhaustive",
}


def fail(message: str) -> None:
    raise SystemExit(message)


def _only_enabled(plan: dict[str, str], *allowed: str) -> bool:
    allowed_set = set(allowed)
    return all(
        (plan[key] == "true") == (key in allowed_set) for key in BOOLEAN_KEYS
    )


def _validate_classification(plan: dict[str, str]) -> None:
    classification = plan["classification"]
    if classification == "docs":
        if not _only_enabled(plan, "run-docs"):
            fail("docs CI must enable only run-docs")
    elif classification == "npm":
        if not _only_enabled(plan, "run-npm"):
            fail("npm CI must enable only run-npm")
    elif classification == "lean":
        if not _only_enabled(plan, "run-lean"):
            fail("lean CI must enable only run-lean")
    elif classification == "python":
        if plan["run-python"] != "true" or not any(
            plan[key] == "true" for key in PYTHON_LANES
        ):
            fail("python CI must enable a semantic Python lane")
    elif classification in {"full", "selective", "exhaustive"}:
        if classification != "exhaustive" and not any(
            plan[key] == "true" for key in FUNCTIONAL_KEYS
        ):
            fail(f"{classification} CI must enable a functional lane")
    else:
        fail(f"unhandled CI classification: {classification}")


def main() -> None:
    plan: dict[str, str] = {}
    for raw_line in sys.stdin:
        line = raw_line.rstrip("\n")
        if "=" not in line:
            fail(f"invalid CI plan line: {line}")
        key, value = line.split("=", 1)
        if key in plan:
            fail(f"duplicate CI plan key: {key}")
        plan[key] = value

    expected = {"classification", *BOOLEAN_KEYS}
    if set(plan) != expected:
        fail(f"CI plan keys differ: expected {sorted(expected)}, got {sorted(plan)}")
    if plan["classification"] not in CLASSIFICATIONS:
        fail(f"invalid CI classification: {plan['classification']}")
    for key in BOOLEAN_KEYS:
        if plan[key] not in {"true", "false"}:
            fail(f"invalid CI plan value for {key}: {plan[key]}")

    has_python = any(plan[key] == "true" for key in PYTHON_LANES)
    if (plan["run-python"] == "true") != has_python:
        fail("run-python must equal the union of semantic Python lanes")
    for key in ("run-coverage", "run-compatibility"):
        if plan[key] == "true" and not (
            plan["run-unit"] == "true" and plan["run-domain"] == "true"
        ):
            fail(f"{key} requires unit and domain lanes")
    if plan["classification"] == "exhaustive":
        if any(plan[key] != "true" for key in BOOLEAN_KEYS):
            fail("exhaustive CI must enable every lane")
    elif plan["run-coverage"] == "true" or plan["run-compatibility"] == "true":
        fail("coverage and compatibility are exhaustive-only lanes")
    _validate_classification(plan)


if __name__ == "__main__":
    main()
