{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "conclusion", "result", "claimed_assurance", "scope", "completeness", "evidence", "limitations"],
  "properties": {
    "task_id": {"const": "jacobian/extremal-subset-sum-semantic-audit"},
    "conclusion": {"enum": ["PROPOSED_FORMALIZATION_FAITHFUL", "PROPOSED_FORMALIZATION_NOT_FAITHFUL", "INSUFFICIENT_EVIDENCE"]},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_status", "defects", "shadowing_certificate", "predicate_certificate"],
      "properties": {
        "semantic_status": {"enum": ["EQUIVALENT", "NOT_EQUIVALENT", "NOT_ASSESSED"]},
        "defects": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"enum": ["OUTER_PARAMETER_SHADOWED", "WHOLE_SET_SUM_REPLACES_SUBSET_SUM"]}
        },
        "shadowing_certificate": {
          "type": "object", "additionalProperties": false,
          "required": ["target", "first_multiplier", "second_multiplier", "first_extremum", "second_extremum"],
          "properties": {
            "target": {"const": 1},
            "first_multiplier": {"type": "integer", "minimum": 0, "maximum": 4},
            "second_multiplier": {"type": "integer", "minimum": 0, "maximum": 4},
            "first_extremum": {"type": "integer", "minimum": 0, "maximum": 4},
            "second_extremum": {"type": "integer", "minimum": 0, "maximum": 4}
          }
        },
        "predicate_certificate": {
          "type": "object", "additionalProperties": false,
          "required": ["target", "universe", "legacy_extremum", "intended_extremum", "legacy_witness", "intended_witness", "blocking_subset"],
          "properties": {
            "target": {"const": 4},
            "universe": {"const": [1, 2, 3]},
            "legacy_extremum": {"type": "integer", "minimum": 0, "maximum": 3},
            "intended_extremum": {"type": "integer", "minimum": 0, "maximum": 3},
            "legacy_witness": {"type": "array", "maxItems": 3, "items": {"type": "integer"}},
            "intended_witness": {"type": "array", "maxItems": 3, "items": {"type": "integer"}},
            "blocking_subset": {"type": "array", "maxItems": 3, "items": {"type": "integer"}}
          }
        }
      }
    },
    "claimed_assurance": {"enum": ["UNVERIFIED", "COMPUTED"]},
    "scope": {"type": "string"},
    "completeness": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "evidence/answer.txt"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
