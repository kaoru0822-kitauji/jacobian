{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacobian.invalid/benchmarks/schemas/routing-observation.schema.json",
  "title": "Jacobian Harbor tool-routing observation v2",
  "description": "Diagnostic evidence for configuration, discovery, invocation, and successful capability use. It never authorizes a mathematical claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "causal_claim_authorized", "status", "source_sha", "dataset", "condition", "resolved_config", "summary", "trials", "validation_failures"],
  "properties": {
    "schema_version": {"const": "2"},
    "evidence_class": {"const": "workflow-routing-observation"},
    "causal_claim_authorized": {"const": false},
    "status": {"enum": ["VALID", "INCOMPLETE"]},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dataset": {"type": "string", "minLength": 1},
    "condition": {"enum": ["control", "treatment"]},
    "resolved_config": {"$ref": "#/$defs/resolved_config"},
    "summary": {"$ref": "#/$defs/summary"},
    "trials": {"type": "array", "items": {"$ref": "#/$defs/trial"}},
    "validation_failures": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "resolved_config": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "digest", "selection_mode", "selection", "n_attempts", "jacobian_mcp_configured", "jacobian_sidecar_configured"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"},
        "selection_mode": {"enum": ["dataset-task-names", "explicit-tasks", "invalid"]},
        "selection": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "n_attempts": {"type": "integer", "minimum": 0},
        "jacobian_mcp_configured": {"type": "boolean"}, "jacobian_sidecar_configured": {"type": "boolean"}
      }
    },
    "opportunity": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "relevant_capability_ids", "rationale"],
      "properties": {
        "value": {"enum": ["NONE", "OPTIONAL", "HIGH", "UNASSESSED"]},
        "relevant_capability_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": ["string", "null"]}
      }
    },
    "rewards": {
      "type": "object", "additionalProperties": false,
      "required": ["correctness", "evidence_validity", "scope_accuracy", "assurance_calibration", "reward", "false_certification"],
      "properties": {
        "correctness": {"type": ["number", "boolean", "null"]}, "evidence_validity": {"type": ["number", "boolean", "null"]},
        "scope_accuracy": {"type": ["number", "boolean", "null"]}, "assurance_calibration": {"type": ["number", "boolean", "null"]},
        "reward": {"type": ["number", "boolean", "null"]}, "false_certification": {"type": ["number", "boolean", "null"]}
      }
    },
    "description": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "query", "domain", "mode", "capability_id", "match_ids"],
      "properties": {
        "kind": {"type": ["string", "null"]}, "query": {"type": ["string", "null"]}, "domain": {"type": ["string", "null"]},
        "mode": {"type": ["string", "null"]}, "capability_id": {"type": ["string", "null"]},
        "match_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["transcript", "turn_usage_present", "mcp_calls", "successful_mcp_calls", "tool_error_count", "capability_attempt_ids", "capability_ids", "capability_descriptions"],
      "properties": {
        "transcript": {"type": ["object", "null"]}, "turn_usage_present": {"type": "boolean"},
        "mcp_calls": {"type": "array", "items": {"type": "string"}}, "successful_mcp_calls": {"type": "array", "items": {"type": "string"}},
        "tool_error_count": {"type": "integer", "minimum": 0}, "capability_attempt_ids": {"type": "array", "items": {"type": "string"}},
        "capability_ids": {"type": "array", "items": {"type": "string"}}, "capability_descriptions": {"type": "array", "items": {"$ref": "#/$defs/description"}}
      }
    },
    "trial": {
      "type": "object", "additionalProperties": false,
      "required": ["task", "task_digest", "repetition", "opportunity", "routing_status", "rewards", "telemetry", "raw_result_digest"],
      "properties": {
        "task": {"type": "string", "minLength": 1}, "task_digest": {"$ref": "#/$defs/digest"}, "repetition": {"type": "integer", "minimum": 0},
        "opportunity": {"$ref": "#/$defs/opportunity"}, "routing_status": {"enum": ["NOT_CONFIGURED", "HARNESS_UNAVAILABLE", "EVIDENCE_INCOMPLETE", "AVAILABLE_NO_CALL", "DISCOVERY_FAILED", "DISCOVERY_MISS", "DESCRIBED_NOT_INVOKED", "INVOKE_FAILED", "USED_OTHER_CAPABILITY", "USED"]},
        "rewards": {"$ref": "#/$defs/rewards"}, "telemetry": {"$ref": "#/$defs/telemetry"}, "raw_result_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["trial_count", "routing_status_counts", "by_tool_opportunity"],
      "properties": {
        "trial_count": {"type": "integer", "minimum": 0},
        "routing_status_counts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["status", "count"], "properties": {"status": {"enum": ["NOT_CONFIGURED", "HARNESS_UNAVAILABLE", "EVIDENCE_INCOMPLETE", "AVAILABLE_NO_CALL", "DISCOVERY_FAILED", "DISCOVERY_MISS", "DESCRIBED_NOT_INVOKED", "INVOKE_FAILED", "USED_OTHER_CAPABILITY", "USED"]}, "count": {"type": "integer", "minimum": 1}}}},
        "by_tool_opportunity": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["value", "trials", "relevant_used", "adoption_rate"], "properties": {"value": {"enum": ["NONE", "OPTIONAL", "HIGH", "UNASSESSED"]}, "trials": {"type": "integer", "minimum": 0}, "relevant_used": {"type": "integer", "minimum": 0}, "adoption_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}}}
      }
    }
  }
}
