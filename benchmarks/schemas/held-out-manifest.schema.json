{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacobian.invalid/benchmarks/schemas/held-out-manifest.schema.json",
  "title": "Private held-out Jacobian evaluation bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "bundle_version", "archive", "dataset", "tasks", "conditions", "experiment"],
  "properties": {
    "schema_version": {"const": "1"},
    "bundle_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "bundle_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "pattern": "^s3://[^/]+/.+\\.tar\\.gz$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "manifest_digest", "minimum_independent_families"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "path": {"const": "dataset"},
        "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "minimum_independent_families": {"type": "integer", "minimum": 2}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "digest", "verifier_path", "verifier_digest", "oracle_path", "oracle_digest"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "family": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "verifier_path": {"type": "string", "pattern": "^dataset/[a-z0-9-]+/tests/verifier\\.py$"},
          "verifier_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "oracle_path": {"type": "string", "pattern": "^dataset/[a-z0-9-]+/solution/"},
          "oracle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "image", "catalog_digest", "policy_digest"],
        "properties": {
          "id": {"enum": ["C1", "C2"]},
          "role": {"enum": ["PRIMARY_CONTROL", "PRIMARY_TREATMENT"]},
          "image": {"type": "string", "pattern": "^[^@]+@sha256:[0-9a-f]{64}$"},
          "catalog_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "prompt_digest", "reasoning_effort", "randomization_seed", "max_tokens", "max_cost_usd", "stages"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "prompt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "reasoning_effort": {"type": "string", "minLength": 1},
        "randomization_seed": {"type": "integer"},
        "max_tokens": {"type": "integer", "minimum": 1},
        "max_cost_usd": {"type": "number", "exclusiveMinimum": 0},
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pilot", "decision"],
          "properties": {
            "pilot": {"$ref": "#/$defs/stage"},
            "decision": {"$ref": "#/$defs/stage"}
          }
        }
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_ids", "repetitions"],
      "properties": {
        "task_ids": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
        "repetitions": {"type": "integer", "minimum": 3}
      }
    }
  }
}
