#!/usr/bin/env python3
"""Render GitHub Actions job timings as a compact Markdown report."""

from __future__ import annotations

import argparse
import json
from datetime import datetime
from pathlib import Path
from typing import Any


def _timestamp(value: str) -> datetime:
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def _jobs(payload: Any) -> list[dict[str, Any]]:
    pages = payload if isinstance(payload, list) else [payload]
    return [
        job
        for page in pages
        for job in page.get("jobs", [])
        if job.get("started_at")
        and job.get("completed_at")
        and job.get("name") != "CI Metrics"
    ]


def _integration_shard_seconds(rows: list[tuple[str, float]]) -> list[float]:
    return [
        seconds
        for name, seconds in rows
        if "integration" in name.casefold() and " of " in name.casefold()
    ]


def render(payload: Any) -> str:
    jobs = _jobs(payload)
    if not jobs:
        raise ValueError("no completed CI jobs found")

    rows: list[tuple[str, float]] = []
    starts: list[datetime] = []
    ends: list[datetime] = []
    for job in jobs:
        started = _timestamp(job["started_at"])
        completed = _timestamp(job["completed_at"])
        starts.append(started)
        ends.append(completed)
        rows.append((job["name"], max(0.0, (completed - started).total_seconds())))

    total_minutes = sum(seconds for _, seconds in rows) / 60
    critical_minutes = (max(ends) - min(starts)).total_seconds() / 60
    longest_name, longest_seconds = max(rows, key=lambda row: row[1])
    lines = [
        "## CI duration",
        "",
        "| Metric | Value |",
        "| --- | ---: |",
        f"| Critical path (workflow elapsed) | {critical_minutes:.1f} min |",
        f"| Total runner time | {total_minutes:.1f} min |",
        f"| Longest job | {longest_name} ({longest_seconds / 60:.1f} min) |",
        f"| Completed jobs | {len(rows)} |",
        "",
    ]
    shard_seconds = _integration_shard_seconds(rows)
    if len(shard_seconds) >= 2:
        slowest = max(shard_seconds)
        fastest = min(shard_seconds)
        skew_ratio = slowest / fastest if fastest > 0 else float("inf")
        lines.extend(
            (
                f"| Integration shard skew (max/min) | {skew_ratio:.2f}x |",
                "",
            )
        )
        if skew_ratio >= 1.5:
            lines.extend(
                (
                    "Integration shards differ by at least 1.5x. The next successful "
                    "main-branch integration run will publish fresh timings; until "
                    "then, shards fall back to equal weighting.",
                    "",
                )
            )
    return "\n".join(lines)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("jobs_json", type=Path)
    args = parser.parse_args()
    payload = json.loads(args.jobs_json.read_text(encoding="utf-8"))
    print(render(payload))


if __name__ == "__main__":
    main()
