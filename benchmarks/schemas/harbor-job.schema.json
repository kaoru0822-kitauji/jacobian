{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacobian.invalid/benchmarks/schemas/harbor-job.schema.json",
  "title": "Harbor job configuration",
  "description": "Reference contract for Harbor job JSON files committed under each dataset. Jobs select Harbor task bundles directly or use Harbor dataset paths and task-name filters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobs_dir", "n_attempts", "timeout_multiplier", "orchestrator", "environment", "agents"],
  "anyOf": [{"required": ["tasks"]}, {"required": ["datasets"]}],
  "properties": {
    "jobs_dir": {"type": "string", "minLength": 1},
    "n_attempts": {"type": "integer", "minimum": 1},
    "timeout_multiplier": {"type": "number", "exclusiveMinimum": 0},
    "orchestrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "n_concurrent_trials": {"type": "integer", "minimum": 1},
        "quiet": {"type": "boolean"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "force_build": {"type": "boolean"},
        "delete": {"type": "boolean"},
        "extra_docker_compose": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "model_name": {"type": "string", "minLength": 1},
          "mcp_servers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "transport", "url"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "transport": {"type": "string", "minLength": 1},
                "url": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "task_names": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {"path": {"type": "string", "minLength": 1}}
      }
    }
  }
}
