{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacobian.invalid/schemas/telemetry-event-1.json",
  "title": "Observable Jacobian evaluation event",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "trial_id", "timestamp", "kind"],
  "properties": {
    "schema_version": {"const": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {
      "enum": [
        "capability.discovery",
        "capability.describe",
        "capability.invoke",
        "capability.parameter_error",
        "artifact.produced",
        "artifact.consumed",
        "verification.record",
        "shell.command",
        "file.read",
        "file.write",
        "trial.completed",
        "trial.timeout"
      ]
    },
    "capability_id": {"type": "string"},
    "arguments_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact_uri": {"type": "string"}
  }
}
